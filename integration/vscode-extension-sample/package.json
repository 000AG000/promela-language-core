{
  "name": "promela-core-vscode-sample",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Development-only ProMeLa VS Code adapter; integrate into your existing extension rather than publishing alongside it.",
  "engines": {
    "vscode": "^1.100.0"
  },
  "extensionKind": [
    "workspace"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onLanguage:promela"
  ],
  "contributes": {
    "languages": [
      {
        "id": "promela",
        "extensions": [
          ".pml"
        ],
        "aliases": [
          "Promela",
          "ProMeLa"
        ],
        "configuration": "./language-configuration.json"
      }
    ]
  },
  "scripts": {
    "sync:core": "node scripts/sync-core.mjs",
    "precheck:types": "node scripts/sync-core.mjs --check",
    "prebuild": "node scripts/sync-core.mjs --check",
    "build": "tsc -p tsconfig.json",
    "check:types": "tsc --noEmit -p tsconfig.json",
    "test:extension-host": "npm run build && node scripts/test-extension-host.mjs",
    "test:adapter": "npm run build && node --test test/*.test.mjs"
  },
  "dependencies": {
    "promela-language-core": "file:../../release/promela-language-core"
  },
  "devDependencies": {
    "@types/vscode": "^1.100.0",
    "typescript": "5.9.3",
    "@types/node": "22.15.0"
  },
  "publisher": "replace-with-your-publisher",
  "license": "MIT"
}
